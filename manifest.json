{
  "manifest_version": 3,
  "name": "Kemono Lens",
  "version": "1.0",
  "description": "管理Kemono網站上的創作者黑名單、收藏和懸停預覽功能",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "scripting"
  ],

  "host_permissions": [
    "https://kemono.cr/*",
    "https://coomer.st/*"
  ],

  "optional_host_permissions": [
    "https://*/*"
  ],
  
  "content_scripts": [
    {
      "matches": [
        "https://kemono.cr/artists*",
        "https://kemono.cr/artists/updated*",
        "https://kemono.cr/*/user/*",
        "https://kemono.cr/account/favorites/artists*",
        "https://kemono.cr/posts*",
        "https://coomer.st/artists*",
        "https://coomer.st/artists/updated*",
        "https://coomer.st/*/user/*",
        "https://coomer.st/account/favorites/artists*",
        "https://coomer.st/posts*"
      ],
      "js": [
        "logger.js",
        "i18n.js",
        "RequestQueue.js",
        "settings.js",
        "util.js",
        "js/DomainConfig.js",
        "sites/kemono.js",
        "sites/coomer.js",
        "sites/index.js",
        "content-scripts/DOMManager.js",
        "content-scripts/BlacklistContentManager.js",
        "content-scripts/FavoritesContentManager.js",
        "content-scripts/reader/ReaderSettings.js",
        "content-scripts/reader/AlbumService.js",
        "content-scripts/reader/book/spreads.js",
        "content-scripts/reader/book/layout.js",
        "content-scripts/reader/book/BookView.js",
        "content-scripts/reader/book/BookThumbs.js",
        "content-scripts/reader/ReaderController.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "content-scripts/reader/reader.css"
      ],
      "run_at": "document_end"
    }
  ],
  
  "options_page": "options.html",
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Kemono Lens - 設定"
  },
  
  "background": {
    "service_worker": "background.js"
  }
}
